<?xml version="1.0"?>
<configuration>

  <configSections>
    <section name="Netlog" type="Nistec.Logging.NetlogConfig, Nistec.Logger, Version=4.7.2.0, Culture=neutral, PublicKeyToken=734a739868a76423" requirePermission="false"/>
    <section name="RemoteQueue" type="Nistec.Messaging.Config.QueueServerConfig, Nistec.Queue.Server, Version=4.7.2.0, Culture=neutral, PublicKeyToken=734a739868a76423" requirePermission="false"/>
  </configSections>


  <Netlog>
    <NetlogSettings>
      <add key="LogFilename" value="C:\Nistec\Services\Logs\QueueClient.log"/>
      <add key="LogLevel" value="Debug|Info|Warn|Error|Trace"/>
      <add key="LogMode" value="File|Console"/>
      <!--<add key="IsAsync" value="true"/>-->
      <add key="AsyncType" value="File|Service"/>
    </NetlogSettings>
  </Netlog>

  
  <appSettings>
    <add key="Protocol" value="tcp"/>
    <add key="HosAddress" value="127.0.0.1:5005"/>
    <add key="PipeName" value="nistec_queue_manager"/>
  </appSettings>

  <RemoteQueue>
    <QueueSettings>
      <add key="IsRemoteAsync" value="false"/>
      <add key="EnableRemoteException" value="true"/>
      <add key="QueueExpiration" value="0"/>
      <add key="SessionTimeout" value="30"/>
    </QueueSettings>
    <TcpClientSettings>
      <host HostName="nistec_queue_manager" Address="127.0.0.1" Port="5005" IsAsync="true" ConnectTimeout="5000000" ProcessTimeout="1000000" ReceiveBufferSize="4096" SendBufferSize="4096" MaxSocketError="50" MaxServerConnections="4"/>
    </TcpClientSettings>
    <!--PipeDirection="In|Out|InOut"  PipeOptions="None|WriteThrough|Asynchronous"-->
    <PipeClientSettings>
      <host HostName="nistec_queue_manager" PipeName="nistec_queue_manager" PipeDirection="InOut" PipeOptions="Asynchronous" IsAsync="true" VerifyPipe="nistec_queue_manager" ConnectTimeout="5000" ReceiveBufferSize="8192" SendBufferSize="8192" MaxServerConnections="1" MaxAllowedServerInstances="255"/>
    </PipeClientSettings>
    <HttpClientSettings>
      <host HostName="nistec_queue_manager" Address="http://localhost:15100/" Method="post" ConnectTimeout="5000000" ProcessTimeout="1000000" MaxErrors="50" MaxServerConnections="1"/>
    </HttpClientSettings>
  </RemoteQueue>
  

  <!--<MQueue>
    <QueueSettings>
      <add key="RootPath" value="C:\Dev\Nistec\Git_4.0.2.0\MQueue\References\"/>
