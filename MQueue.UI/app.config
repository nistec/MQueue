    <TcpServerSettings>
      <host HostName="nistec_queue_manager" Address="127.0.0.1" Port="5005" IsAsync="true" ConnectTimeout="5000000" ProcessTimeout="1000000" ReceiveBufferSize="4096" SendBufferSize="4096" MaxSocketError="50" MaxServerConnections="4"/>
    </TcpServerSettings>
    <HttpServerSettings>
      <host HostName="nistec_queue_manager" Address="http://localhost:15100/" Method="post" ConnectTimeout="5000000" ProcessTimeout="1000000" MaxErrors="50" MaxServerConnections="1"/>
    </HttpServerSettings>

  </MQueue>-->
  
